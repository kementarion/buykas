{
  "name": "openpress",
  "version": "0.1.0",
  "description": "A tiny, dependency-free static site generator.",
  "keywords": ["static-site-generator", "ssg", "markdown", "documentation"],
  "type": "module",
  "license": "GPL-3.0",
  "bin": {
    "openpress": "./bin/openpress.js"
  },
  "exports": {
    ".": "./index.js",
    "./config": "./src/config.js",
    "./theme": "./src/theme.js",
    "./markdown": "./src/markdown/index.js",
    "./themes/default": "./themes/default/index.js",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "themes",
    "vendor",
    "doc",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  }
}
